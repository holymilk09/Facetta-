# Facetta environment configuration.
# Copy to `.env` (gitignored) and fill in what you need. An exported shell
# variable always wins over a value in this file.

# --- Database ---------------------------------------------------------------
# Unset -> zero-setup local SQLite (./facetta.db). Set it to use PostgreSQL.
# For Supabase, click Connect and paste the URI for your selected connection
# method. A bare postgres:// / postgresql:// scheme is fine: Facetta routes it
# to psycopg v3 automatically. See README -> Database -> Supabase.
#
# Direct connection (simplest; needs IPv6):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Session pooler (IPv4-friendly, long-lived server):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Transaction pooler (serverless; port 6543, prepared statements auto-disabled):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- First-party Studio authentication --------------------------------------
# Default is `required`: /projects/* and /studio/* fail closed without a
# configured bearer token. `local` is an explicit developer-only bypass;
# automated tests set `test` explicitly. Never use local/test in a public beta.
# FACETTA_AUTH_MODE=required
# JSON maps server-issued session tokens to canonical principal IDs. Supply it
# through deployment secrets, not a committed file.
# FACETTA_AUTH_PRINCIPALS_JSON={"replace-with-long-session-token":"usr_owner"}

# --- API keys (optional; only for the AI + render endpoints) ----------------
# Loaded into the process environment at app startup, so each provider client
# picks them up. A real exported env var overrides the file.
# ANTHROPIC_API_KEY=   # optional legacy prose -> spec and edit agent
# FAL_KEY=             # photoreal renders / blueprint sheets via fal.ai
# XAI_KEY=             # Grok Imagine + Grok Vision concept/photo extraction
# OPENAI_API_KEY=      # optional direct GPT Image comparison route
