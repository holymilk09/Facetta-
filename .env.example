# Facetta environment configuration.
# Copy to `.env` (gitignored) and fill in what you need. An exported shell
# variable always wins over a value in this file.

# --- Database ---------------------------------------------------------------
# Unset -> zero-setup local SQLite (./facetta.db). Set it to use PostgreSQL.
# For Supabase, click Connect and paste the URI for your selected connection
# method. A bare postgres:// / postgresql:// scheme is fine: Facetta routes it
# to psycopg v3 automatically. See README -> Database -> Supabase.
#
# Direct connection (simplest; needs IPv6):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Session pooler (IPv4-friendly, long-lived server):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Transaction pooler (serverless; port 6543, prepared statements auto-disabled):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- First-party Studio authentication --------------------------------------
# Production refuses to boot unless Supabase asymmetric-JWT verification is
# selected. Configure an asymmetric signing key in Supabase; HS256 is rejected.
# FACETTA_ENV=production
# FACETTA_AUTH_MODE=supabase
# FACETTA_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# FACETTA_SUPABASE_AUDIENCE=authenticated
# Immutable commit SHA or release identifier injected into the deployed API.
# The live two-principal gate compares this server-reported value with the
# revision selected for approval; do not set it only in the probe environment.
# FACETTA_DEPLOYMENT_REVISION=0123456789abcdef
# Comma-separated exact Studio web origins. Production defaults to no browser
# origins, never wildcard CORS.
# FACETTA_CORS_ORIGINS=https://studio.example.com
#
# `opaque` plus FACETTA_AUTH_PRINCIPALS_JSON is an internal compatibility mode.
# `local` and `test` are explicit non-public bypasses. None may be used in
# production. FACETTA_ENV defaults to production so local development must set
# FACETTA_ENV=development explicitly.
# FACETTA_AUTH_PRINCIPALS_JSON={"replace-with-long-internal-token":"usr_owner"}

# Expo mobile/web client authentication. These values are public client
# configuration, not privileged backend secrets. Never expose service_role.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- API keys (optional; only for the AI + render endpoints) ----------------
# Loaded into the process environment at app startup, so each provider client
# picks them up. A real exported env var overrides the file.
# ANTHROPIC_API_KEY=   # optional legacy prose -> spec and edit agent
# FAL_KEY=             # photoreal renders / blueprint sheets via fal.ai
# XAI_KEY=             # Grok Imagine + Grok Vision concept/photo extraction
# OPENAI_API_KEY=      # optional direct GPT Image comparison route
