{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.1",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:studio": "tsx --test src/studio/*.test.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react-native-webview$": "<rootDir>/src/trusted/testWebView.tsx"
    },
    "testMatch": [
      "**/src/trusted/**/*.test.ts",
      "**/src/trusted/**/*.test.tsx",
      "**/src/studio/**/*.test.tsx"
    ]
  },
  "private": true
}
